/*
|--------------------------------------------------------------------------
| Per-evidence qualification
|--------------------------------------------------------------------------
*/

function analyseEvidence({
    records,
    specification,
    selectedDeviceInstance =
        null,
}) {
    const candidateRecords =
        recordsForAttribute(
            records,
            specification
                .attributeId
        );


    if (
        candidateRecords.length ===
        0
    ) {
        return {
            ...emptyEvidenceBlock(),

            attributeId:
                specification
                    .attributeId,

            path:
                specification
                    .path,

            dataKind:
                specification
                    .dataKind,
        };
    }


    const observedDeviceInstances =
        distinctDeviceInstances(
            candidateRecords
        );


    let selectedRecords =
        candidateRecords;


    let resolvedDeviceInstance =
        null;


    if (
        selectedDeviceInstance !==
        null &&
        selectedDeviceInstance !==
        undefined
    ) {
        selectedRecords =
            filterDevice(
                candidateRecords,
                selectedDeviceInstance
            );


        resolvedDeviceInstance =
            normalizeDeviceInstance(
                selectedDeviceInstance
            );


        if (
            selectedRecords.length ===
            0
        ) {
            return {
                ...emptyEvidenceBlock(),

                attributeId:
                    specification
                        .attributeId,

                path:
                    specification
                        .path,

                dataKind:
                    specification
                        .dataKind,

                reason:
                    SOLAR_ENERGY_ANALYTICS_REASON
                        .SELECTED_DEVICE_NOT_FOUND,

                topology: {
                    status:
                        SOLAR_ENERGY_TOPOLOGY_STATUS
                            .UNAVAILABLE,

                    observedDeviceInstances,

                    selectedDeviceInstance:
                        resolvedDeviceInstance,

                    ambiguous:
                        false,
                },

                evidence: {
                    candidateRecords:
                        candidateRecords
                            .length,

                    recordsUsed:
                        0,

                    duplicateTimestampCount:
                        0,

                    conflictingTimestampCount:
                        0,
                },
            };
        }
    }
    else {
        if (
            observedDeviceInstances.length >
            1
        ) {
            return {
                ...emptyEvidenceBlock(),

                attributeId:
                    specification
                        .attributeId,

                path:
                    specification
                        .path,

                dataKind:
                    specification
                        .dataKind,

                reason:
                    SOLAR_ENERGY_ANALYTICS_REASON
                        .DEVICE_TOPOLOGY_AMBIGUOUS,

                topology: {
                    status:
                        SOLAR_ENERGY_TOPOLOGY_STATUS
                            .AMBIGUOUS,

                    observedDeviceInstances,

                    selectedDeviceInstance:
                        null,

                    ambiguous:
                        true,
                },

                evidence: {
                    candidateRecords:
                        candidateRecords
                            .length,

                    recordsUsed:
                        0,

                    duplicateTimestampCount:
                        0,

                    conflictingTimestampCount:
                        0,
                },
            };
        }


        resolvedDeviceInstance =
            observedDeviceInstances[
                0
            ] ??
            null;
    }


    const prepared =
        prepareSeries(
            selectedRecords
        );


    if (
        prepared
            .series
            .length ===
        0
    ) {
        return {
            ...emptyEvidenceBlock(),

            attributeId:
                specification
                    .attributeId,

            path:
                specification
                    .path,

            dataKind:
                specification
                    .dataKind,

            reason:
                SOLAR_ENERGY_ANALYTICS_REASON
                    .NO_VALID_SOLAR_ENERGY_SAMPLES,

            topology: {
                status:
                    SOLAR_ENERGY_TOPOLOGY_STATUS
                        .QUALIFIED,

                observedDeviceInstances,

                selectedDeviceInstance:
                    resolvedDeviceInstance,

                ambiguous:
                    false,
            },

            evidence: {
                candidateRecords:
                    selectedRecords
                        .length,

                recordsUsed:
                    0,

                duplicateTimestampCount:
                    prepared
                        .duplicateTimestampCount,

                conflictingTimestampCount:
                    prepared
                        .conflictingTimestampCount,
            },
        };
    }


    const unit =
        qualifyUnit(
            selectedRecords
        );


    if (
        unit.status ===
        "CONFLICT"
    ) {
        return {
            ...emptyEvidenceBlock(),

            attributeId:
                specification
                    .attributeId,

            path:
                specification
                    .path,

            dataKind:
                specification
                    .dataKind,

            reason:
                SOLAR_ENERGY_ANALYTICS_REASON
                    .UNIT_METADATA_CONFLICT,

            topology: {
                status:
                    SOLAR_ENERGY_TOPOLOGY_STATUS
                        .QUALIFIED,

                observedDeviceInstances,

                selectedDeviceInstance:
                    resolvedDeviceInstance,

                ambiguous:
                    false,
            },

            unit,

            metrics:
                calculateSeriesMetrics(
                    prepared
                        .series
                ),

            evidence: {
                candidateRecords:
                    selectedRecords
                        .length,

                recordsUsed:
                    prepared
                        .series
                        .length,

                duplicateTimestampCount:
                    prepared
                        .duplicateTimestampCount,

                conflictingTimestampCount:
                    prepared
                        .conflictingTimestampCount,
            },
        };
    }


    const unitResolved =
        unit.status ===
        SOLAR_UNIT_STATUS
            .RESOLVED;


    let reason =
        unitResolved
            ? SOLAR_ENERGY_ANALYTICS_REASON
                .SOLAR_ENERGY_CALCULATED
            : SOLAR_ENERGY_ANALYTICS_REASON
                .SOLAR_YIELD_UNIT_UNRESOLVED;


    let status =
        unitResolved
            ? SOLAR_ENERGY_ANALYTICS_STATUS
                .CALCULATED
            : SOLAR_ENERGY_ANALYTICS_STATUS
                .PARTIALLY_CALCULATED;


    let dailyHistory =
        null;


    let counter =
        null;


    let delta =
        null;


    if (
        specification
            .dataKind ===
        SOLAR_ENERGY_DATA_KIND
            .DAILY_HISTORY
    ) {
        dailyHistory =
            calculateDailyYieldDiagnostics(
                prepared
                    .series
            );
    }


    if (
        specification
            .dataKind ===
        SOLAR_ENERGY_DATA_KIND
            .COUNTER
    ) {
        counter =
            calculateCounterDiagnostics(
                prepared
                    .series
            );


        /*
         * A resolved engineering unit is not sufficient by itself to turn
         * a conditional counter into reporting-window energy.
         *
         * We expose the counter diagnostics, but the actual counter-delta
         * energy remains unresolved until counter semantics are explicitly
         * qualified.
         */
        status =
            SOLAR_ENERGY_ANALYTICS_STATUS
                .PARTIALLY_CALCULATED;


        reason =
            counter
                .decreaseCount >
            0
                ? SOLAR_ENERGY_ANALYTICS_REASON
                    .COUNTER_DECREASE_OBSERVED
                : SOLAR_ENERGY_ANALYTICS_REASON
                    .COUNTER_SEMANTICS_UNRESOLVED;
    }


    if (
        specification
            .dataKind ===
        SOLAR_ENERGY_DATA_KIND
            .DELTA
    ) {
        delta =
            calculateDeltaDiagnostics(
                prepared
                    .series
            );


        /*
         * Even with an explicit unit, attr340 remains conditional until
         * its accumulation semantics are established.
         */
        status =
            SOLAR_ENERGY_ANALYTICS_STATUS
                .PARTIALLY_CALCULATED;


        reason =
            SOLAR_ENERGY_ANALYTICS_REASON
                .YIELD_DELTA_SEMANTICS_UNRESOLVED;
    }


    return {
        attributeId:
            specification
                .attributeId,

        path:
            specification
                .path,

        dataKind:
            specification
                .dataKind,

        status,

        reason,

        topology: {
            status:
                SOLAR_ENERGY_TOPOLOGY_STATUS
                    .QUALIFIED,

            observedDeviceInstances,

            selectedDeviceInstance:
                resolvedDeviceInstance,

            ambiguous:
                false,
        },

        unit,

        metrics:
            calculateSeriesMetrics(
                prepared
                    .series
            ),

        dailyHistory,

        counter,

        delta,

        evidence: {
            candidateRecords:
                selectedRecords
                    .length,

            recordsUsed:
                prepared
                    .series
                    .length,

            duplicateTimestampCount:
                prepared
                    .duplicateTimestampCount,

            conflictingTimestampCount:
                prepared
                    .conflictingTimestampCount,
        },
    };
}


/*
|--------------------------------------------------------------------------
| Overall status
|--------------------------------------------------------------------------
*/

function deriveOverallStatus(
    evidenceBlocks
) {
    const blocks =
        Object.values(
            evidenceBlocks
        );


    const calculated =
        blocks.filter(
            (
                block
            ) =>
                block.status ===
                SOLAR_ENERGY_ANALYTICS_STATUS
                    .CALCULATED
        );


    const partial =
        blocks.filter(
            (
                block
            ) =>
                block.status ===
                SOLAR_ENERGY_ANALYTICS_STATUS
                    .PARTIALLY_CALCULATED
        );


    if (
        calculated.length >
        0
    ) {
        return {
            status:
                SOLAR_ENERGY_ANALYTICS_STATUS
                    .CALCULATED,

            reason:
                SOLAR_ENERGY_ANALYTICS_REASON
                    .SOLAR_ENERGY_CALCULATED,
        };
    }


    if (
        partial.length >
        0
    ) {
        return {
            status:
                SOLAR_ENERGY_ANALYTICS_STATUS
                    .PARTIALLY_CALCULATED,

            reason:
                SOLAR_ENERGY_ANALYTICS_REASON
                    .SOLAR_YIELD_UNIT_UNRESOLVED,
        };
    }


    return {
        status:
            SOLAR_ENERGY_ANALYTICS_STATUS
                .UNAVAILABLE,

        reason:
            SOLAR_ENERGY_ANALYTICS_REASON
                .NO_SOLAR_ENERGY_EVIDENCE,
    };
}


/*
|--------------------------------------------------------------------------
| Main service
|--------------------------------------------------------------------------
*/

export function calculateSolarEnergyAnalytics({
    records = [],
    start,
    end,
    selectedDeviceInstance = null,
    config = {},
} = {}) {
    const reportingStart =
        validDate(
            start
        );


    const reportingEnd =
        validDate(
            end
        );


    if (
        !reportingStart ||
        !reportingEnd ||
        reportingStart >=
        reportingEnd
    ) {
        return {
            family:
                SOLAR_ENERGY_ANALYTICS_FAMILY,

            phase:
                SOLAR_ENERGY_ANALYTICS_PHASE,

            status:
                SOLAR_ENERGY_ANALYTICS_STATUS
                    .UNAVAILABLE,

            reason:
                SOLAR_ENERGY_ANALYTICS_REASON
                    .INVALID_REPORTING_WINDOW,

            reportingWindow: {
                start:
                    reportingStart,

                end:
                    reportingEnd,

                semantics:
                    "[start,end)",
            },

            selectedDeviceInstance:
                selectedDeviceInstance ===
                    null ||
                selectedDeviceInstance ===
                    undefined
                    ? null
                    : normalizeDeviceInstance(
                        selectedDeviceInstance
                    ),

            energy: {
                value:
                    null,

                unit:
                    null,

                calculated:
                    false,
            },

            evidence: {
                totalInputRecords:
                    Array.isArray(
                        records
                    )
                        ? records.length
                        : 0,

                qualifiedInputRecords:
                    0,

                solarEnergyCandidateRecords:
                    0,
            },

            sources: {
                yieldToday:
                    emptyEvidenceBlock(),

                yieldYesterday:
                    emptyEvidenceBlock(),

                userYield:
                    emptyEvidenceBlock(),

                userYieldDelta:
                    emptyEvidenceBlock(),
            },

            boundaries:
                SOLAR_ENERGY_ANALYTICS_BOUNDARIES,
        };
    }


    const resolvedConfig =
        normalizeConfig(
            config
        );


    /*
    |--------------------------------------------------------------------------
    | Production-quality boundary
    |--------------------------------------------------------------------------
    */

    const qualifiedRecords =
        Array.isArray(
            records
        )
            ? records.filter(
                (
                    record
                ) =>
                    recordPassesBaseBoundary({
                        record,
                        start:
                            reportingStart,
                        end:
                            reportingEnd,
                        config:
                            resolvedConfig,
                    })
            )
            : [];


    /*
    |--------------------------------------------------------------------------
    | Solar-energy/yield candidates only
    |--------------------------------------------------------------------------
    */

    const candidateRecords =
        qualifiedRecords.filter(
            (
                record
            ) =>
                ENERGY_ATTRIBUTE_IDS.includes(
                    Number(
                        record
                            ?.vrmAttributeId
                    )
                )
        );


    const yieldToday =
        analyseEvidence({
            records:
                candidateRecords,

            specification:
                ENERGY_EVIDENCE_SPECIFICATIONS[
                    0
                ],

            selectedDeviceInstance,
        });


    const yieldYesterday =
        analyseEvidence({
            records:
                candidateRecords,

            specification:
                ENERGY_EVIDENCE_SPECIFICATIONS[
                    1
                ],

            selectedDeviceInstance,
        });


    const userYield =
        analyseEvidence({
            records:
                candidateRecords,

            specification:
                ENERGY_EVIDENCE_SPECIFICATIONS[
                    2
                ],

            selectedDeviceInstance,
        });


    const userYieldDelta =
        analyseEvidence({
            records:
                candidateRecords,

            specification:
                ENERGY_EVIDENCE_SPECIFICATIONS[
                    3
                ],

            selectedDeviceInstance,
        });


    const sources = {
        yieldToday,
        yieldYesterday,
        userYield,
        userYieldDelta,
    };


    const overall =
        deriveOverallStatus(
            sources
        );


    /*
    |--------------------------------------------------------------------------
    | Canonical reporting-window energy
    |--------------------------------------------------------------------------
    |
    | Deliberately null in the current semantic contract.
    |
    | A daily-history observation is not automatically reporting-window
    | interval energy. A cumulative counter is not usable until counter
    | semantics are qualified. A delta stream is not summed until its
    | accumulation semantics are qualified.
    |
    | This prevents "some yield number exists" from becoming fabricated
    | kWh.
    |--------------------------------------------------------------------------
    */

    return {
        family:
            SOLAR_ENERGY_ANALYTICS_FAMILY,

        phase:
            SOLAR_ENERGY_ANALYTICS_PHASE,

        status:
            overall
                .status,

        reason:
            overall
                .reason,

        reportingWindow: {
            start:
                reportingStart,

            end:
                reportingEnd,

            semantics:
                "[start,end)",
        },

        selectedDeviceInstance:
            selectedDeviceInstance ===
                null ||
            selectedDeviceInstance ===
                undefined
                ? null
                : normalizeDeviceInstance(
                    selectedDeviceInstance
                ),

        energy: {
            value:
                null,

            unit:
                null,

            calculated:
                false,

            reason:
                "REPORTING_WINDOW_ENERGY_NOT_YET_SEMANTICALLY_QUALIFIED",
        },

        evidence: {
            totalInputRecords:
                Array.isArray(
                    records
                )
                    ? records.length
                    : 0,

            qualifiedInputRecords:
                qualifiedRecords
                    .length,

            solarEnergyCandidateRecords:
                candidateRecords
                    .length,

            attributeIds:
                ENERGY_ATTRIBUTE_IDS,
        },

        sources,

        boundaries:
            SOLAR_ENERGY_ANALYTICS_BOUNDARIES,
    };
}


/*
|--------------------------------------------------------------------------
| Default export
|--------------------------------------------------------------------------
*/

export default Object.freeze({
    SOLAR_ENERGY_ANALYTICS_PHASE,
    SOLAR_ENERGY_ANALYTICS_FAMILY,
    SOLAR_ENERGY_ANALYTICS_STATUS,
    SOLAR_ENERGY_ANALYTICS_REASON,
    SOLAR_ENERGY_PATH,
    SOLAR_ENERGY_DATA_KIND,
    SOLAR_ENERGY_TOPOLOGY_STATUS,
    DEFAULT_SOLAR_ENERGY_ANALYTICS_CONFIG,
    SOLAR_ENERGY_ANALYTICS_BOUNDARIES,
    calculateSolarEnergyAnalytics,
});