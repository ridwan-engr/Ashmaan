/*
|--------------------------------------------------------------------------
| Helpers
|--------------------------------------------------------------------------
*/

function finiteNumber(
    value
) {
    if (
        value === null ||
        value === undefined ||
        value === ""
    ) {
        return null;
    }


    const numeric =
        Number(
            value
        );


    return Number.isFinite(
        numeric
    )
        ? numeric
        : null;
}


function validDate(
    value
) {
    if (
        value === null ||
        value === undefined
    ) {
        return null;
    }


    const date =
        value instanceof Date
            ? value
            : new Date(
                value
            );


    return Number.isFinite(
        date.getTime()
    )
        ? date
        : null;
}


function normalizeDeviceInstance(
    value
) {
    if (
        value === null ||
        value === undefined ||
        String(
            value
        ).trim() === ""
    ) {
        return "UNKNOWN_DEVICE";
    }


    return String(
        value
    );
}


function normalizeUnit(
    value
) {
    if (
        value === null ||
        value === undefined
    ) {
        return null;
    }


    const unit =
        String(
            value
        ).trim();


    return unit === ""
        ? null
        : unit;
}


function extractExplicitUnit(
    record
) {
    /*
     * Explicit persisted metadata only.
     *
     * Do NOT infer from:
     * - magnitude
     * - parameter name
     * - DBus path
     * - formatWithUnit
     */

    return (
    normalizeUnit(
        record?.unit
    ) ??
    normalizeUnit(
        record?.engineeringUnit
    ) ??
    null
);
}


function normalizeConfig(
    config
) {
    return {
        ...DEFAULT_SOLAR_ENERGY_ANALYTICS_CONFIG,
        ...(
            config ??
            {}
        ),
    };
}


function recordPassesBaseBoundary({
    record,
    start,
    end,
    config,
}) {
    const timestamp =
        validDate(
            record
                ?.timestamp
        );


    if (
        !timestamp
    ) {
        return false;
    }


    if (
        timestamp < start ||
        timestamp >= end
    ) {
        return false;
    }


    if (
        config
            .requireValidQuality &&
        record
            ?.quality !==
            "VALID"
    ) {
        return false;
    }


    if (
        config
            .requireRawAggregation &&
        record
            ?.aggregationLevel !==
            "RAW"
    ) {
        return false;
    }


    return true;
}


function recordsForAttribute(
    records,
    attributeId
) {
    return records.filter(
        (
            record
        ) =>
            Number(
                record
                    ?.vrmAttributeId
            ) ===
            Number(
                attributeId
            )
    );
}


function distinctDeviceInstances(
    records
) {
    return Array.from(
        new Set(
            records.map(
                (
                    record
                ) =>
                    normalizeDeviceInstance(
                        record
                            ?.deviceInstance
                    )
            )
        )
    ).sort();
}


function filterDevice(
    records,
    deviceInstance
) {
    const normalized =
        normalizeDeviceInstance(
            deviceInstance
        );


    return records.filter(
        (
            record
        ) =>
            normalizeDeviceInstance(
                record
                    ?.deviceInstance
            ) ===
            normalized
    );
}


/*
|--------------------------------------------------------------------------
| Timestamp preparation
|--------------------------------------------------------------------------
|
| Identical same-timestamp observations are deduplicated.
|
| Conflicting values at the same timestamp are discarded because there is
| no defensible basis for selecting one as authoritative.
|--------------------------------------------------------------------------
*/

function prepareSeries(
    records
) {
    const byTimestamp =
        new Map();


    for (
        const record
        of records
    ) {
        const timestamp =
            validDate(
                record
                    ?.timestamp
            );


        const numeric =
            finiteNumber(
                record
                    ?.numericValue
            ) ??
            finiteNumber(
                record
                    ?.value
            );


        if (
            !timestamp ||
            numeric === null
        ) {
            continue;
        }


        const key =
            timestamp.toISOString();


        if (
            !byTimestamp.has(
                key
            )
        ) {
            byTimestamp.set(
                key,
                []
            );
        }


        byTimestamp
            .get(
                key
            )
            .push({
                timestamp,
                value:
                    numeric,
                record,
            });
    }


    const series =
        [];


    let duplicateTimestampCount =
        0;


    let conflictingTimestampCount =
        0;


    for (
        const observations
        of byTimestamp.values()
    ) {
        const uniqueValues =
            Array.from(
                new Set(
                    observations.map(
                        (
                            observation
                        ) =>
                            observation.value
                    )
                )
            );


        if (
            uniqueValues.length >
            1
        ) {
            conflictingTimestampCount +=
                1;

            continue;
        }


        if (
            observations.length >
            1
        ) {
            duplicateTimestampCount +=
                observations.length -
                1;
        }


        series.push({
            timestamp:
                observations[
                    0
                ].timestamp,

            value:
                observations[
                    0
                ].value,

            record:
                observations[
                    0
                ].record,
        });
    }


    series.sort(
        (
            a,
            b
        ) =>
            a.timestamp -
            b.timestamp
    );


    return {
        series,
        duplicateTimestampCount,
        conflictingTimestampCount,
    };
}


/*
|--------------------------------------------------------------------------
| Explicit unit qualification
|--------------------------------------------------------------------------
*/

function qualifyUnit(
    records
) {
    const units =
        Array.from(
            new Set(
                records
                    .map(
                        extractExplicitUnit
                    )
                    .filter(
                        (
                            unit
                        ) =>
                            unit !== null
                    )
            )
        );


    if (
        units.length ===
        0
    ) {
        return {
            status:
                SOLAR_UNIT_STATUS
                    .UNRESOLVED,

            value:
                null,

            observedUnits:
                [],
        };
    }


    if (
        units.length ===
        1
    ) {
        return {
            status:
                SOLAR_UNIT_STATUS
                    .RESOLVED,

            value:
                units[
                    0
                ],

            observedUnits:
                units,
        };
    }


    return {
        status:
            "CONFLICT",

        value:
            null,

        observedUnits:
            units,
    };
}


/*
|--------------------------------------------------------------------------
| Generic series metrics
|--------------------------------------------------------------------------
*/

function calculateSeriesMetrics(
    series
) {
    if (
        !Array.isArray(
            series
        ) ||
        series.length ===
            0
    ) {
        return {
            sampleCount:
                0,

            minimum:
                null,

            maximum:
                null,

            latest:
                null,

            latestAt:
                null,

            first:
                null,

            firstAt:
                null,

            zeroCount:
                0,

            positiveCount:
                0,

            negativeCount:
                0,
        };
    }


    const values =
        series.map(
            (
                point
            ) =>
                point.value
        );


    const firstPoint =
        series[
            0
        ];


    const latestPoint =
        series[
            series.length -
            1
        ];


    return {
        sampleCount:
            values.length,

        minimum:
            Math.min(
                ...values
            ),

        maximum:
            Math.max(
                ...values
            ),

        latest:
            latestPoint.value,

        latestAt:
            latestPoint.timestamp,

        first:
            firstPoint.value,

        firstAt:
            firstPoint.timestamp,

        zeroCount:
            values.filter(
                (
                    value
                ) =>
                    value ===
                    0
            ).length,

        positiveCount:
            values.filter(
                (
                    value
                ) =>
                    value >
                    0
            ).length,

        negativeCount:
            values.filter(
                (
                    value
                ) =>
                    value <
                    0
            ).length,
    };
}


/*
|--------------------------------------------------------------------------
| Counter diagnostics
|--------------------------------------------------------------------------
*/

function calculateCounterDiagnostics(
    series
) {
    let increaseCount =
        0;


    let unchangedCount =
        0;


    let decreaseCount =
        0;


    let positiveDeltaTotal =
        0;


    const decreases =
        [];


    for (
        let index = 1;
        index <
        series.length;
        index += 1
    ) {
        const previous =
            series[
                index -
                1
            ];


        const current =
            series[
                index
            ];


        const delta =
            current.value -
            previous.value;


        if (
            delta >
            0
        ) {
            increaseCount +=
                1;

            positiveDeltaTotal +=
                delta;
        }
        else if (
            delta ===
            0
        ) {
            unchangedCount +=
                1;
        }
        else {
            decreaseCount +=
                1;

            decreases.push({
                from:
                    previous.value,

                to:
                    current.value,

                previousAt:
                    previous.timestamp,

                currentAt:
                    current.timestamp,

                delta,
            });
        }
    }


    return {
        increaseCount,
        unchangedCount,
        decreaseCount,

        /*
         * Diagnostic only.
         *
         * This is NOT labelled solar energy because counter semantics and
         * engineering units must first be qualified.
         */
        positiveDeltaTotal,

        decreases,

        resetConfirmed:
            false,

        rolloverConfirmed:
            false,
    };
}


/*
|--------------------------------------------------------------------------
| Daily-history diagnostics
|--------------------------------------------------------------------------
|
| Daily-yield telemetry is a repeated state/history value.
|
| We therefore expose observations but never sum samples across time.
|--------------------------------------------------------------------------
*/

function calculateDailyYieldDiagnostics(
    series
) {
    if (
        series.length ===
        0
    ) {
        return {
            latestObservedValue:
                null,

            latestObservedAt:
                null,

            distinctValueCount:
                0,

            changedWithinWindow:
                false,

            summed:
                false,
        };
    }


    const distinctValues =
        Array.from(
            new Set(
                series.map(
                    (
                        point
                    ) =>
                        point.value
                )
            )
        );


    const latest =
        series[
            series.length -
            1
        ];


    return {
        latestObservedValue:
            latest.value,

        latestObservedAt:
            latest.timestamp,

        distinctValueCount:
            distinctValues.length,

        changedWithinWindow:
            distinctValues.length >
            1,

        summed:
            false,
    };
}


/*
|--------------------------------------------------------------------------
| Delta diagnostics
|--------------------------------------------------------------------------
*/

function calculateDeltaDiagnostics(
    series
) {
    const values =
        series.map(
            (
                point
            ) =>
                point.value
        );


    return {
        sampleCount:
            values.length,

        zeroCount:
            values.filter(
                (
                    value
                ) =>
                    value ===
                    0
            ).length,

        positiveCount:
            values.filter(
                (
                    value
                ) =>
                    value >
                    0
            ).length,

        negativeCount:
            values.filter(
                (
                    value
                ) =>
                    value <
                    0
            ).length,

        /*
         * Deliberately not summed into energy while delta semantics and
         * engineering units remain unresolved.
         */
        total:
            null,

        summed:
            false,
    };
}


