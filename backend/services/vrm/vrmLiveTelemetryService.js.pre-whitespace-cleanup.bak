import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

import mqtt from "mqtt";

import env from "../../config/env.js";
import vrmApiClient from "./apiClient.js";

import {
    parseVrmLiveTelemetryMessage,
} from "./vrmLiveTelemetryParser.js";

import {
    qualifyLiveSiteMappings,
} from "./vrmLiveSiteQualificationService.js";

import {
    publishSiteTelemetry,
} from "../../realtime/socketServer.js";

const __filename =
    fileURLToPath(import.meta.url);

const __dirname =
    path.dirname(__filename);

const VRM_CA_PATH =
    path.resolve(
        __dirname,
        "../../certs/venus-ca.crt"
    );

const KEEPALIVE_INTERVAL_MS =
    30_000;

const RECONNECT_MIN_MS =
    5_000;

const RECONNECT_MAX_MS =
    60_000;

const RECONNECT_JITTER_RATIO =
    0.20;

/*
 * Build the exact set of notification
 * topics permitted to enter ASHMAAN.
 *
 * No broad Portal notification wildcard
 * subscription is used.
 *
 * 28 evidence-backed telemetry topics
 * + full_publish_completed marker.
 */
const buildNotificationTopics = (
    portalId,
    approvedMappings
) => {
    if (
        !Array.isArray(
            approvedMappings
        ) ||
        approvedMappings.length ===
        0
    ) {
        throw new Error(
            "At least one site-qualified live telemetry mapping is required."
        );
    }

    const telemetryTopics =
        approvedMappings.map(
            (mapping) =>
                `N/${portalId}/${mapping.serviceType}/${mapping.deviceInstance}${mapping.dbusPath}`
        );

    /*
     * Defensive deduplication.
     *
     * Qualification should already
     * produce unique tuple identities,
     * but production subscription must
     * not rely on that assumption.
     */
    const uniqueTelemetryTopics =
        Array.from(
            new Set(
                telemetryTopics
            )
        );

    return Object.freeze([
        ...uniqueTelemetryTopics,
        `N/${portalId}/full_publish_completed`,
    ]);
};

const connections =
    new Map();

let shuttingDown =
    false;

const normalizeSiteId = (
    value
) => {
    const normalized =
        String(
            value ?? ""
        ).trim();

    if (
        !/^\d+$/.test(
            normalized
        )
    ) {
        throw new Error(
            "A valid VRM site ID is required."
        );
    }

    return normalized;
};

const extractInstallations = (
    payload
) => {
    if (
        Array.isArray(
            payload?.records
        )
    ) {
        return payload.records;
    }

    if (
        Array.isArray(
            payload?.data?.records
        )
    ) {
        return payload.data.records;
    }

    if (
        Array.isArray(
            payload?.installations
        )
    ) {
        return payload.installations;
    }

    if (
        Array.isArray(payload)
    ) {
        return payload;
    }

    return [];
};

const discoverLiveSource =
    async (
        vrmSiteId
    ) => {
        if (!env.vrm.userId) {
            throw new Error(
                "VRM_USER_ID is not configured."
            );
        }

        const response =
            await vrmApiClient.get(
                `/users/${env.vrm.userId}/installations`,
                {
                    params: {
                        extended: 1,
                    },
                }
            );

        const installations =
            extractInstallations(
                response.data
            );

        const installation =
            installations.find(
                (candidate) =>
                    Number(
                        candidate.idSite ??
                        candidate.idsite ??
                        candidate.siteId ??
                        candidate.id
                    ) ===
                    Number(vrmSiteId)
            );

        if (!installation) {
            throw new Error(
                `VRM installation ${vrmSiteId} was not found.`
            );
        }

        const portalId =
            String(
                installation.identifier ??
                ""
            ).trim();

        const mqttHost =
            String(
                installation.mqtt_host ??
                ""
            ).trim();

        if (
            !/^[0-9a-f]{12}$/i.test(
                portalId
            )
        ) {
            throw new Error(
                `VRM installation ${vrmSiteId} has no valid Portal ID.`
            );
        }

        if (
            !/^[a-z0-9.-]+$/i.test(
                mqttHost
            )
        ) {
            throw new Error(
                `VRM installation ${vrmSiteId} has no valid MQTT host.`
            );
        }

        return {
            portalId,
            mqttHost,
        };
    };

const readVrmCa = () => {
    if (
        !fs.existsSync(
            VRM_CA_PATH
        )
    ) {
        throw new Error(
            `Victron MQTT CA certificate is missing: ${VRM_CA_PATH}`
        );
    }

    const ca =
        fs.readFileSync(
            VRM_CA_PATH
        );

    if (ca.length === 0) {
        throw new Error(
            "Victron MQTT CA certificate is empty."
        );
    }

    return ca;
};

const publishKeepalive = (
    state,
    suppressRepublish
) =>
    new Promise(
        (
            resolve,
            reject
        ) => {
            if (
                !state.client ||
                !state.client.connected
            ) {
                reject(
                    new Error(
                        "VRM MQTT client is not connected."
                    )
                );

                return;
            }

            const payload =
                suppressRepublish
                    ? JSON.stringify({
                        "keepalive-options": [
                            "suppress-republish",
                        ],
                    })
                    : "{}";

            /*
             * Read/keepalive request only.
             *
             * ASHMAAN does not publish
             * VRM write/control topics.
             */
            state.client.publish(
                `R/${state.portalId}/keepalive`,
                payload,
                {
                    qos: 0,
                    retain: false,
                },
                (error) => {
                    if (error) {
                        reject(error);
                        return;
                    }

                    resolve();
                }
            );
        }
    );

const stopKeepalive = (
    state
) => {
    if (
        state.keepaliveTimer
    ) {
        clearInterval(
            state.keepaliveTimer
        );

        state.keepaliveTimer =
            null;
    }
};

const startKeepalive = (
    state
) => {
    stopKeepalive(
        state
    );

    state.keepaliveTimer =
        setInterval(
            () => {
                if (
                    shuttingDown ||
                    state.stopping ||
                    !state.client
                        ?.connected
                ) {
                    return;
                }

                publishKeepalive(
                    state,
                    true
                ).catch(
                    (error) => {
                        console.error(
                            `[VRM MQTT] keepalive failed for site ${state.vrmSiteId}:`,
                            error.message
                        );
                    }
                );
            },
            KEEPALIVE_INTERVAL_MS
        );

    state.keepaliveTimer
        ?.unref?.();
};

const scheduleReconnect = (
    state
) => {
    if (
        shuttingDown ||
        state.stopping ||
        state.reconnectTimer
    ) {
        return false;
    }

    const delay =
        calculateReconnectDelay(
            state.reconnectAttempt
        );

    state.reconnectAttempt +=
        1;

    state.lastReconnectDelayMs =
        delay;

    console.warn(
        `[VRM MQTT] site ${state.vrmSiteId} reconnect scheduled in ${delay} ms`
    );

    state.reconnectTimer =
        setTimeout(
            async () => {
                state.reconnectTimer =
                    null;

                /*
                 * The state must still be
                 * the registered owner of
                 * this site. This prevents
                 * a stale timer from
                 * resurrecting a stopped or
                 * replaced connection.
                 */
                if (
                    shuttingDown ||
                    state.stopping ||
                    connections.get(
                        state.vrmSiteId
                    ) !== state
                ) {
                    return;
                }

                try {
                    await connectState(
                        state
                    );
                } catch (error) {
                    console.error(
                        `[VRM MQTT] reconnect failed for site ${state.vrmSiteId}:`,
                        error.message
                    );

                    scheduleReconnect(
                        state
                    );
                }
            },
            delay
        );

    state.reconnectTimer
        ?.unref?.();

    return true;
};

const calculateReconnectDelay = (
    reconnectAttempt,
    randomValue = Math.random()
) => {
    const normalizedAttempt =
        Math.max(
            0,
            Math.floor(
                Number(
                    reconnectAttempt
                ) || 0
            )
        );

    /*
     * Clamp the exponent as well as the
     * resulting delay so an extremely
     * large reconnectAttempt cannot
     * overflow 2 ** attempt.
     */
    const maximumExponent =
        Math.ceil(
            Math.log2(
                RECONNECT_MAX_MS /
                RECONNECT_MIN_MS
            )
        );

    const boundedAttempt =
        Math.min(
            normalizedAttempt,
            maximumExponent
        );

    const baseDelay =
        Math.min(
            RECONNECT_MIN_MS *
            2 **
            boundedAttempt,
            RECONNECT_MAX_MS
        );

    const normalizedRandom =
        Number.isFinite(
            Number(randomValue)
        )
            ? Math.min(
                1,
                Math.max(
                    0,
                    Number(
                        randomValue
                    )
                )
            )
            : 0.5;

    /*
     * Convert [0,1] into [-1,+1].
     */
    const signedJitter =
        normalizedRandom * 2 - 1;

    const jitter =
        baseDelay *
        RECONNECT_JITTER_RATIO *
        signedJitter;

    /*
     * The final reconnect delay itself
     * remains inside the configured
     * production bounds.
     */
    return Math.round(
        Math.min(
            RECONNECT_MAX_MS,
            Math.max(
                RECONNECT_MIN_MS,
                baseDelay +
                jitter
            )
        )
    );
};

const handleMessage = (
    state,
    topic,
    payload
) => {
    /*
     * Victron full-publication completion
     * remains useful diagnostic metadata.
     *
     * It is not treated as the sole
     * live-readiness criterion.
     */
    if (
        topic ===
        `N/${state.portalId}/full_publish_completed`
    ) {
        state.fullPublishCompleted =
            true;

        console.log(
            `[VRM MQTT] initial publication complete for site ${state.vrmSiteId}`
        );

        return;
    }

    const parsed =
        parseVrmLiveTelemetryMessage({
            vrmSiteId:
                state.vrmSiteId,

            portalId:
                state.portalId,

            topic,

            payload,

            receivedAt:
                new Date().toISOString(),
        });

    if (!parsed.accepted) {
        return;
    }

    /*
     * Only parser-approved telemetry
     * contributes to live readiness.
     *
     * Rejected, unmapped or malformed
     * MQTT messages cannot make the
     * service appear healthy.
     */
    state.receivedTelemetryCount +=
        1;

    state.lastTelemetryAt =
        parsed.record.timestamp;

    /*
     * Live telemetry is intentionally
     * NOT persisted to MongoDB here.
     *
     * Historical persistence remains
     * telemetrySyncService's responsibility.
     */
    publishSiteTelemetry({
        vrmSiteId:
            state.vrmSiteId,

        timestamp:
            parsed.record.timestamp,

        records: [
            parsed.record,
        ],
    });
};

const connectState =
    async (
        state
    ) => {
        if (
            shuttingDown ||
            state.stopping
        ) {
            return;
        }

        if (
            !env.vrm.accessToken
        ) {
            throw new Error(
                "VRM_ACCESS_TOKEN is not configured."
            );
        }

        if (
            !env.vrm.mqttUsername
        ) {
            throw new Error(
                "VRM_MQTT_USERNAME is not configured."
            );
        }

        stopKeepalive(
            state
        );

        /*
         * A new MQTT session must prove
         * its own subscription and live
         * telemetry readiness.
         */
        state.subscriptionCount =
            0;

        state.receivedTelemetryCount =
            0;

        state.lastTelemetryAt =
            null;

        state.approvedMappings =
            Object.freeze([]);

        state.approvedMappingCount =
            0;

        if (
            state.client
        ) {
            try {
                state.client
                    .removeAllListeners();

                state.client.end(
                    true
                );
            } catch {
                // Best-effort cleanup.
            }

            state.client =
                null;
        }

        const {
            portalId,
            mqttHost,
        } =
            await discoverLiveSource(
                state.vrmSiteId
            );

        state.portalId =
            portalId;

        state.mqttHost =
            mqttHost;

        state.fullPublishCompleted =
            false;

        state.receivedTelemetryCount =
            0;

        state.lastTelemetryAt =
            null;

        const qualification =
            await qualifyLiveSiteMappings(
                state.vrmSiteId
            );

        if (
            qualification
                .approvedMappingCount <=
            0
        ) {
            throw new Error(
                `VRM installation ${state.vrmSiteId} has no evidence-backed live telemetry mappings.`
            );
        }

        state.approvedMappings =
            qualification.approvedMappings;

        state.approvedMappingCount =
            qualification.approvedMappingCount;

        const ca =
            readVrmCa();

        const client =
            mqtt.connect(
                `mqtts://${mqttHost}:${env.vrm.mqttPort}`,
                {
                    clientId:
                        `ashmaan-${state.vrmSiteId}-${Date.now()}`,

                    username:
                        env.vrm.mqttUsername,

                    password:
                        `Token ${env.vrm.accessToken}`,

                    protocolVersion:
                        4,

                    clean:
                        true,

                    reconnectPeriod:
                        0,

                    connectTimeout:
                        15_000,

                    ca,

                    rejectUnauthorized:
                        true,
                }
            );

        state.client =
            client;

        client.on(
            "message",
            (
                topic,
                payload
            ) => {
                handleMessage(
                    state,
                    topic,
                    payload
                );
            }
        );

        client.on(
            "error",
            (error) => {
                if (
                    shuttingDown ||
                    state.stopping
                ) {
                    return;
                }

                console.error(
                    `[VRM MQTT] site ${state.vrmSiteId} error:`,
                    error.message
                );
            }
        );

        client.on(
            "close",
            () => {
                stopKeepalive(
                    state
                );

                /*
                 * A disconnected client
                 * no longer has an active
                 * MQTT subscription.
                 *
                 * Historical evidence of
                 * the last accepted live
                 * telemetry is retained
                 * until the next connection
                 * attempt resets it.
                 */
                state.subscriptionCount =
                    0;

                if (
                    shuttingDown ||
                    state.stopping
                ) {
                    return;
                }

                console.warn(
                    `[VRM MQTT] connection closed for site ${state.vrmSiteId}`
                );

                scheduleReconnect(
                    state
                );
            }
        );

        await new Promise(
            (
                resolve,
                reject
            ) => {
                let settled =
                    false;

                const timeout =
                    setTimeout(
                        () => {
                            if (
                                settled
                            ) {
                                return;
                            }

                            settled =
                                true;

                            reject(
                                new Error(
                                    `VRM MQTT connection timed out for site ${state.vrmSiteId}.`
                                )
                            );
                        },
                        15_000
                    );

                client.once(
                    "connect",
                    () => {
                        if (
                            settled
                        ) {
                            return;
                        }

                        settled =
                            true;

                        clearTimeout(
                            timeout
                        );

                        resolve();
                    }
                );

                client.once(
                    "error",
                    (error) => {
                        if (
                            settled
                        ) {
                            return;
                        }

                        settled =
                            true;

                        clearTimeout(
                            timeout
                        );

                        reject(
                            error
                        );
                    }
                );
            }
        );

        /*
         * Subscribe only to exact
         * evidence-backed notification
         * topics.
         *
         * Broad Portal notification
         * subscriptions are prohibited.
         */
        const notificationTopics =
            buildNotificationTopics(
                portalId,
                state.approvedMappings
            );

        await new Promise(
            (
                resolve,
                reject
            ) => {
                client.subscribe(
                    notificationTopics,
                    {
                        qos: 0,
                    },
                    (
                        error,
                        granted
                    ) => {
                        if (error) {
                            reject(
                                error
                            );

                            return;
                        }

                        const accepted =
                            Array.isArray(
                                granted
                            ) &&
                            granted.length ===
                            notificationTopics.length &&
                            granted.every(
                                (entry) =>
                                    entry.qos !==
                                    128
                            );

                        if (!accepted) {
                            reject(
                                new Error(
                                    `VRM MQTT exact-topic subscription was not fully granted for site ${state.vrmSiteId}.`
                                )
                            );

                            return;
                        }

                        resolve();
                    }
                );
            }
        );

        state.subscriptionCount =
            notificationTopics.length;

        /*
         * Initial empty keepalive asks
         * Victron to republish current
         * values for subscribed topics.
         */
        await publishKeepalive(
            state,
            false
        );

        state.reconnectAttempt =
            0;

        state.lastReconnectDelayMs =
            null;

        startKeepalive(
            state
        );

        console.log(
            `[VRM MQTT] live telemetry connected for site ${state.vrmSiteId} via ${mqttHost}`
        );
    };

const startVrmLiveTelemetry =
    async (
        vrmSiteId
    ) => {
        const normalizedSiteId =
            normalizeSiteId(
                vrmSiteId
            );

        shuttingDown =
            false;

        const existing =
            connections.get(
                normalizedSiteId
            );

        if (
            existing &&
            !existing.stopping
        ) {
            return existing;
        }

        const state = {
            vrmSiteId:
                normalizedSiteId,

            portalId:
                null,

            mqttHost:
                null,

            approvedMappings:
                Object.freeze([]),

            approvedMappingCount:
                0,

            client:
                null,

            keepaliveTimer:
                null,

            reconnectTimer:
                null,

            reconnectAttempt:
                0,

            lastReconnectDelayMs:
                null,

            fullPublishCompleted:
                false,

            subscriptionCount:
                0,

            receivedTelemetryCount:
                0,

            lastTelemetryAt:
                null,

            stopping:
                false,
        };

        connections.set(
            normalizedSiteId,
            state
        );

        try {
            await connectState(
                state
            );

            return state;
        } catch (error) {
            /*
             * Initial-start failure belongs to
             * the caller.
             *
             * Do not arm an autonomous reconnect
             * before the caller has accepted
             * ownership of this live connection.
             *
             * Fleet startup can therefore mark
             * the site FAILED and clean it up
             * without racing a pending reconnect.
             */
            state.stopping =
                true;

            stopKeepalive(
                state
            );

            if (state.client) {
                const client =
                    state.client;

                state.client =
                    null;

                state.subscriptionCount =
                    0;

                client.removeAllListeners();

                try {
                    client.end(
                        true
                    );
                } catch {
                    // Best-effort cleanup.
                }
            }

            connections.delete(
                normalizedSiteId
            );

            throw error;
        }
    };

const stopVrmLiveTelemetry =
    async (
        vrmSiteId
    ) => {
        const normalizedSiteId =
            normalizeSiteId(
                vrmSiteId
            );

        const state =
            connections.get(
                normalizedSiteId
            );

        if (!state) {
            return false;
        }

        state.stopping =
            true;

        stopKeepalive(
            state
        );

        if (
            state.reconnectTimer
        ) {
            clearTimeout(
                state.reconnectTimer
            );

            state.reconnectTimer =
                null;
        }

        if (
            state.client
        ) {
            const client =
                state.client;

            state.client =
                null;

            state.subscriptionCount =
                0;

            client.removeAllListeners();

            await new Promise(
                (resolve) => {
                    client.end(
                        true,
                        {},
                        resolve
                    );
                }
            );
        }

        connections.delete(
            normalizedSiteId
        );

        console.log(
            `[VRM MQTT] live telemetry stopped for site ${normalizedSiteId}`
        );

        return true;
    };

const closeVrmLiveTelemetry =
    async () => {
        shuttingDown =
            true;

        const siteIds =
            Array.from(
                connections.keys()
            );

        await Promise.allSettled(
            siteIds.map(
                (siteId) =>
                    stopVrmLiveTelemetry(
                        siteId
                    )
            )
        );

        console.log(
            "[VRM MQTT] live telemetry service closed"
        );
    };

const getVrmLiveTelemetryState =
    (
        vrmSiteId
    ) => {
        const normalizedSiteId =
            normalizeSiteId(
                vrmSiteId
            );

        const state =
            connections.get(
                normalizedSiteId
            );

        if (!state) {
            return null;
        }

        /*
         * Never expose credentials,
         * MQTT password or access token.
         *
         * Only operationally safe
         * connection/readiness metadata
         * is returned.
         */
        return Object.freeze({
            vrmSiteId:
                state.vrmSiteId,

            portalId:
                state.portalId,

            mqttHost:
                state.mqttHost,

            connected:
                state.client
                    ?.connected ===
                true,

            approvedMappingCount:
                state.approvedMappingCount,

            fullPublishCompleted:
                state.fullPublishCompleted,

            subscriptionCount:
                state.subscriptionCount,

            receivedTelemetryCount:
                state.receivedTelemetryCount,

            lastTelemetryAt:
                state.lastTelemetryAt,

            reconnectAttempt:
                state.reconnectAttempt,

            reconnectScheduled:
                state.reconnectTimer !==
                null,

            lastReconnectDelayMs:
                state.lastReconnectDelayMs,

            stopping:
                state.stopping,
        });
    };

export {
    startVrmLiveTelemetry,
    stopVrmLiveTelemetry,
    closeVrmLiveTelemetry,
    getVrmLiveTelemetryState,
    calculateReconnectDelay,
};

